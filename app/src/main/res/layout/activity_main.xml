<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zsdsh_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chromeBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zsdsh_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/zsdsh_text"
            android:textSize="12sp"
            android:maxLines="2" />

        <Button
            android:id="@+id/btnShizuku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/grant_shizuku"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnEngine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/start_engine"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnChrome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/collapse_chrome"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/peekChip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zsdsh_panel"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/zsdsh_muted"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hintText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:textColor="@color/zsdsh_muted"
        android:textSize="11sp" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
